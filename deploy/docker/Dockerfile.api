FROM python:3.13-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY apps/api apps/api
COPY packages/compiler packages/compiler
COPY packages/examples packages/examples
COPY workers/fluka_runner workers/fluka_runner

RUN pip install --no-cache-dir \
    -e apps/api \
    -e packages/compiler \
    -e workers/fluka_runner

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--app-dir", "apps/api", "--host", "0.0.0.0", "--port", "8000"]
